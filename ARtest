<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Storybook AR - Page 1</title>
  <!-- Google's Model Viewer library -->
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
  <style>
    body { margin: 0; padding: 0; width: 100vw; height: 100vh; overflow: hidden; background: #ffffff; }
    model-viewer { width: 100%; height: 100%; }
    .ar-button {
      position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
      padding: 14px 28px; background: #FF5722; color: white; border: none;
      border-radius: 30px; font-weight: bold; font-size: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>

  <!-- Make sure character.glb and character.usdz match your exact filenames -->
  <model-viewer 
    src="character.glb" 
    ios-src="character.usdz" 
    ar 
    ar-modes="scene-viewer quick-look webxr" 
    camera-controls 
    auto-rotate 
    shadow-intensity="1">
    
    <button slot="ar-button" class="ar-button">
      ✨ Tap to view in your room!
    </button>

  </model-viewer>

</body>
</html>
